#: ../class-wc-gateway-systempay.php:407
msgid "Payment page URL"
msgstr "URL de página de pago"

#: ../class-wc-gateway-systempay.php:410
msgid "Link to the payment page."
msgstr "Enlace a la página de pago."

#: ../class-wc-gateway-systempay.php:416 ../class-wc-gateway-systempaystd.php:327
msgid "PAYMENT PAGE"
msgstr "PÁGINA DE PAGO"

#: ../class-wc-gateway-systempay.php:420
msgid "Default language"
msgstr "Idioma por defecto"

#: ../class-wc-gateway-systempay.php:424
