msgstr "%s no es compatible con la moneda de su tienda."

#: ../class-wc-gateway-systempay.php:151
msgid "Your %s module configuration is successfully reset."
msgstr "La configuración de su módulo %s se restableció correctamente."

#: ../class-wc-gateway-systempay.php:157
msgid ""
"The module works by sending users to %s in order to select their payment "
"mean and enter their payment information."
msgstr ""
"El módulo trabaja al enviar usuarios a %s para seleccionar su medio de pago "
"e ingresar su información de pago."

